# LOKA Pay .gitignore (pre-event kit). Includes every rule from LOKA's original .gitignore.

# ---- Private material: never in this repo ----
# Anchored at the root: LOKA's own docs/research/ notes are public and stay tracked.
/research/
/submissions/
/video/
/team-pdf/
*.pdf
*strategy*.md
*-private.md

# ---- Secrets and signing assets ----
.env
.env.*
!.env.example
*.p8
*.p12
*.pem
*.key
*.cer
*.mobileprovision
*.provisionprofile
AuthKey_*.p8
service-account*.json
*-keypair.json
*.keypair.json
# Keystore files (LOKA)
*.jks
*.keystore
# Google Services (LOKA)
google-services.json

# ---- Node / TypeScript / Next.js / Vercel ----
node_modules/
.pnpm-store/
.next/
out/
dist/
coverage/
.turbo/
*.tsbuildinfo
.vercel/
playwright-report/
test-results/
blob-report/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# ---- Rust / Solana / Anchor ----
target/
**/*.rs.bk
.anchor/
test-ledger/

# ---- Xcode / Swift ----
DerivedData/
*.xcuserstate
xcuserdata/
*.ipa
*.dSYM
*.dSYM.zip
.build/
.swiftpm/xcode/

# ---- Gradle / Android (LOKA rules) ----
.gradle/
build/
local.properties
captures/
.externalNativeBuild/
.cxx/
*.aab
*.apk
output-metadata.json
*.hprof

# ---- IDE (LOKA rules plus common editors) ----
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml
.vscode/
*.swp
*.swo

# ---- OS ----
.DS_Store
.AppleDouble
._*
Thumbs.db

# ---- Logs (LOKA rule) ----
*.log

# ---- Local agent and tool state ----
.claude/settings.local.json
.claude/worktrees/
*.import-logs/

# ---- Generated measurement drafts (task 3.6): inputs to the reviewed fill PR, never committed as is ----
/experiments/EXP-PAY-001.draft.md
/experiments/EXP-PAY-001.draft.json
