# LOKA Pay environment variables: NAMES ONLY. Never put a real value in this file.
# Real values live in the VPS secret environment (server), the Vercel project
# settings (web) or a local .env that git ignores. Keep this file in step with the
# code that reads it: every name here is read somewhere, and every name the code
# reads is here (checked in task 4.2).
# TODO(1.0, 1.9): Jordan and Pravin confirm the final names when writing server/src/env.ts.

# ---- Settlement API (server/) ----
NODE_ENV=
PORT=
PUBLIC_BASE_URL=
CORS_ALLOWED_ORIGINS=
PINS_PATH=
DATABASE_URL=

# ---- Solana ----
SOLANA_CLUSTER=
SOLANA_RPC_URL=
LOKA_VAULT_PROGRAM_ID=
USDC_MINT=
# Fee payers and funding wallets (D14, D15). Secret keys, VPS only.
SOLANA_FEE_PAYER_DEMO_SECRET=
SOLANA_FEE_PAYER_PUBLIC_SECRET=
WALLET_TABLE_DEMO_SECRET=
WALLET_PUBLIC_ONBOARDING_SECRET=
WALLET_SEND_SECRET=
WALLET_CANARY_SECRET=
# Daily budgets, in mint base units
BUDGET_PUBLIC_ONBOARDING_DAILY=
BUDGET_SEND_DAILY=

# ---- Server identity keys (1.0). Secret keys, VPS only. ----
LOKA_NODE_RSA_PRIVATE_KEY=
SERVER_ED25519_SECRET=

# ---- Voice and calls ----
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=
ELEVENLABS_VOICE_ID=
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY=
VONAGE_FROM_NUMBER=
BUDGET_SMS_AND_VOICE_DAILY=

# ---- iMessage agent (3.47 to 3.49) ----
# Server-side only: the VPS secret environment. Never in web/ or a NEXT_PUBLIC_ variable.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
GEMINI_API_KEY=

# ---- Passkeys (3.23) ----
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# ---- Card funding, T3 (3.31), Stripe test mode only ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Web (web/), public values only ----
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SOLANA_CLUSTER=
NEXT_PUBLIC_EXPLORER_BASE_URL=
