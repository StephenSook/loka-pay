# Variables the web app reads (names only). All of them are optional; without the /call ones
# below, phone calls are off. Unset, every read uses Solana's public devnet endpoints (lib/solana.ts).

# Server only: the RPC endpoint for the reads behind /judge, /proof and /trust
# (lib/server-rpc.ts). Never sent to a browser, so it may be a keyed provider URL.
SOLANA_RPC_URL=

# PUBLIC: anything named NEXT_PUBLIC_ is inlined into every visitor's browser at build
# time. NEVER put an API key in these. Each accepts only Solana's public devnet endpoint
# that needs no key (https://api.devnet.solana.com and wss://api.devnet.solana.com); any
# other URL fails the build (lib/solana.ts publicEndpoint), because a provider can carry
# its key in the path as well as the query. /live and /privacy name these hosts.
NEXT_PUBLIC_SOLANA_RPC_URL=
NEXT_PUBLIC_SOLANA_WS_URL=

# Server only: a GitHub token for the reads behind /judge and /proof (each workflow's result
# on main and the commit count). Without it GitHub allows 60 requests an hour per IP, which
# shared hosting addresses can use up; with it, the token's limit applies. A fine-grained
# token with read-only access to public repositories is enough. It is sent only from the
# server to api.github.com, never to a browser, and never logged (lib/github.ts).
GITHUB_TOKEN=

# Server only, TESTS ONLY: GITHUB_API_URL may replace https://api.github.com only with a local
# endpoint (127.0.0.1, localhost), and SOLANA_RPC_URL may name a local endpoint, only while
# LOKA_E2E_UPSTREAM=1 (the e2e test mode, set by playwright.config.ts). A deployed production
# build refuses both. In test mode no GitHub token is sent except the e2e stand-in's test
# token; otherwise GITHUB_TOKEN goes only to https://api.github.com (lib/test-upstream.ts).
GITHUB_API_URL=
LOKA_E2E_UPSTREAM=

# Server only: the /call phone call (lib/call-server.ts, PLAN.md 3.9). Calls are off (POST
# /api/call answers 503 calls_off) unless all five of these are set. None is ever sent to a
# browser or logged.
# The Vonage application id (Voice capability).
LOKA_VONAGE_APPLICATION_ID=
# The Vonage application's RSA key, as the base64 of its PEM file (one line).
LOKA_VONAGE_PRIVATE_KEY_B64=
# The Vonage number calls come from: digits in E.164 form, without the plus.
LOKA_VONAGE_FROM_NUMBER=
# The ElevenLabs API key that makes the voice.
ELEVENLABS_API_KEY=
# A random secret of at least 32 bytes: signs the audio links and keys the call limits.
LOKA_CALL_SECRET=
# Optional: 1 turns calls off whatever else is set.
LOKA_CALLS_OFF=
# The desk code given out at the LOKA Pay table. REQUIRED for calls on any host: at least 8
# letters and digits, with at least one of each, or calls are off. Every call request must
# carry it (403 wrong_code otherwise; after 10 wrong codes from one address in 10 minutes, that
# address's wrong codes get 429, while a correct code still goes through).
# Only LOKA_CALL_TEST_MODE below may skip it.
LOKA_CALL_CODE=
# Optional: the ElevenLabs voice id (default: the premade voice "Sarah").
LOKA_ELEVENLABS_VOICE_ID=
# Optional: the https origin Vonage fetches the voice from (default https://zerobars.us).
LOKA_PUBLIC_ORIGIN=

# Server only, TESTS ONLY: like GITHUB_API_URL, these may replace the real Vonage and
# ElevenLabs APIs only with a local endpoint, only while LOKA_E2E_UPSTREAM=1, and never in a
# deployed production build. A local LOKA_PUBLIC_ORIGIN has the same rule.
LOKA_VONAGE_API_URL=
LOKA_ELEVENLABS_API_URL=
# TESTS ONLY: 1 lets a local test run go without a valid desk code. Refused wherever VERCEL or
# VERCEL_ENV is set.
LOKA_CALL_TEST_MODE=
