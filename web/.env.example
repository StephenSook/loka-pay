# Variables the web app reads (names only). All three are optional.
# Unset, every read uses Solana's public devnet endpoints (lib/solana.ts).

# Server only: the RPC endpoint for the reads behind /judge, /proof and /trust
# (lib/server-rpc.ts). Never sent to a browser, so it may be a keyed provider URL.
SOLANA_RPC_URL=

# PUBLIC: anything named NEXT_PUBLIC_ is inlined into every visitor's browser at build
# time. NEVER put an API key in these. A URL with a query string or credentials (where
# providers put ?api-key=) fails the build (lib/solana.ts publicEndpoint). /live and
# /privacy name these hosts.
NEXT_PUBLIC_SOLANA_RPC_URL=
NEXT_PUBLIC_SOLANA_WS_URL=
