{
  "name": "loka-pay-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:e2e": "next start -H 127.0.0.1 -p 3100",
    "postinstall": "pnpm --dir ../protocol/lib install --frozen-lockfile",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "playwright test -c playwright.unit.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@lokapay/protocol": "link:../protocol/lib",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "jsqr": "1.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
